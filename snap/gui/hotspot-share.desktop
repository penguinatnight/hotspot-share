[Desktop Entry]
Version=1.0
Type=Application
Name=Hotspot Share
GenericName=File Transfer & Clipboard Sync
Comment=High-speed local Wi-Fi file sharing & clipboard synchronization between Phone and PC
Exec=hotspot-share %F
Icon=hotspot-share
Terminal=false
Categories=Network;FileTransfer;
StartupNotify=true
StartupWMClass=hotspot-share
MimeType=application/octet-stream;
Keywords=hotspot;share;transfer;wifi;phone;files;clipboard;HotspotShare;hotspot-share;localsend;airdrop;quickshare;
Actions=HeadlessMode;

[Desktop Action HeadlessMode]
Name=Start Headless Terminal Server
Exec=hotspot-share.cli
